---
interface Props {
	lang: 'en' | 'fr';
}

const { lang } = Astro.props;
---

<a href="#" data-email-link>{lang === 'en' ? 'Send an email' : 'Envoyer un courriel'}</a>

<script is:inline>
	(() => {
		const local = [112, 105, 111, 116, 114, 46, 116, 111, 117, 114, 107, 105, 110, 101];
		const domain = [108, 97, 112, 116, 104, 46, 99, 110, 114, 115, 46, 102, 114];
		const decode = (codes) => String.fromCharCode(...codes);
		const address = `${decode(local)}@${decode(domain)}`;

		document.querySelectorAll('[data-email-link]').forEach((link) => {
			link.setAttribute('href', `mailto:${address}`);
		});
	})();
</script>
