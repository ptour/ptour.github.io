---
interface Props {
	lang: 'en' | 'fr';
}

const { lang } = Astro.props;

// The address is written once here. The markup carries a readable but
// scraper-unfriendly form, and the character codes the script needs, so a
// visitor still gets a usable address if the script never runs — whether
// because JavaScript is off or a server CSP blocks inline scripts.
const address = 'piotr.tourkine@lapth.cnrs.fr';
const display = address.replace('@', ' [at] ');
const encoded = address.split('').map((char) => char.charCodeAt(0)).join(',');
---

<!-- No href until the script supplies a real one: a mailto: built from the
     obfuscated form would open a draft addressed to an invalid address. -->
<a
	data-email-link
	data-email={encoded}
	aria-label={lang === 'en' ? 'Email address' : 'Adresse électronique'}>{display}</a
>

<script is:inline>
	(() => {
		document.querySelectorAll('[data-email-link]').forEach((link) => {
			const codes = link.getAttribute('data-email');
			if (!codes) return;
			const address = String.fromCharCode(...codes.split(',').map(Number));
			link.setAttribute('href', `mailto:${address}`);
			link.textContent = address;
		});
	})();
</script>
