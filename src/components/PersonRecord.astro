---
interface Props {
	person: {
		label: string;
		inspire: string;
		scholar?: string;
	};
}

const { person } = Astro.props;
---

<span>{person.label}</span>
<span class="person-record__links">
	<a href={person.inspire} target="_blank" rel="noreferrer">INSPIRE</a>
	{person.scholar && <a href={person.scholar} target="_blank" rel="noreferrer">Scholar</a>}
</span>
