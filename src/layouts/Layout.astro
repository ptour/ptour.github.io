---
import ProfileRail from '../components/ProfileRail.astro';
import '../styles/global.css';
import { alternateLang, analytics, routeMap, withBase, type Lang, type RouteKey } from '../data/site';

interface Props {
	lang: Lang;
	route: RouteKey;
	title: string;
	description: string;
}

const { lang, route, title, description } = Astro.props;
const siteTitle = title === 'Piotr Tourkine' ? title : `${title} | Piotr Tourkine`;
// The lab server is the main address; the GitHub Pages copy is a mirror.
// Both builds therefore point search engines at the lab URLs.
const MAIN_SITE = 'https://lapth.cnrs.fr/pg-nomin/tourkine';
const canonical = `${MAIN_SITE}${routeMap[lang][route]}`;
const alternate = `${MAIN_SITE}${routeMap[alternateLang[lang]][route]}`;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
		<link rel="icon" href={withBase('/favicon.ico')} />
		<link rel="alternate" hreflang={lang === 'en' ? 'fr' : 'en'} href={alternate} />
		<link rel="alternate" hreflang={lang} href={canonical} />
		<link rel="canonical" href={canonical} />
		<meta property="og:title" content={siteTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<title>{siteTitle}</title>
		{analytics.enabled && (
			<script
				data-goatcounter={`https://${analytics.goatCounterCode}.goatcounter.com/count`}
				async
				src="//gc.zgo.at/count.js"
			></script>
		)}
	</head>
	<body>
		<div class="shell site-shell">
			<ProfileRail lang={lang} currentRoute={route} />
			<main class="site-main">
				<article class="content-column">
					<slot />
				</article>
			</main>
		</div>
	</body>
</html>
