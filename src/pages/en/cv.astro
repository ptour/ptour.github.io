---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import PersonRecord from '../../components/PersonRecord.astro';
import EmailLink from '../../components/EmailLink.astro';
import { careerTimeline, siteContent, siteIdentity, supervisees } from '../../data/site';

const content = siteContent.en.cv;
---

<Layout lang="en" route="cv" title={content.title} description={content.description}>
	<section class="page-intro">
		<p class="eyebrow">Academic profile</p>
		<h1>{content.title}</h1>
		<p class="page-intro__subtitle">{siteIdentity.affiliation} · {siteIdentity.location}</p>
		<p class="page-intro__lead">{content.shortBio}</p>
	</section>

	<Section title="Research areas" lede={content.researchParagraph}>
		<ul class="bullet-list">
			{content.researchAreas.map((item) => <li>{item}</li>)}
		</ul>
	</Section>

	<Section title="Current position">
		<div class="contact-panel">
			<p>{siteIdentity.name}</p>
			<p>{siteIdentity.title.en}</p>
			<p>{siteIdentity.affiliation}</p>
			<p>{siteIdentity.office.en}</p>
			<p><EmailLink lang="en" /></p>
		</div>
	</Section>

	<Section title="Academic trajectory">
		<div class="timeline">
			<ul>
				{
					careerTimeline.en.map((item) => (
						<li>
							<div class="timeline__period">{item.period}</div>
							<div>{item.text}</div>
						</li>
					))
				}
			</ul>
		</div>
	</Section>

	<Section title="Supervision">
		<ul class="bullet-list">
			{supervisees.en.postdocs.map((person) => <li><PersonRecord person={person} /></li>)}
			{supervisees.en.phds.map((person) => <li><PersonRecord person={person} /></li>)}
			{supervisees.en.masters.map((item) => <li>{item}</li>)}
		</ul>
	</Section>

	<Section title="Links and profiles" lede={content.linksIntro}>
		<ul class="link-list">
			<li><a href={siteIdentity.links.inspire}>INSPIRE</a></li>
			<li><a href={siteIdentity.links.arxiv}>arXiv author page</a></li>
			<li><a href={siteIdentity.links.scholar}>Google Scholar</a></li>
		</ul>
	</Section>
</Layout>
