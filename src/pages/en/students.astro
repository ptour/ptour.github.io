---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import PersonRecord from '../../components/PersonRecord.astro';
import { siteContent, supervisees } from '../../data/site';

const content = siteContent.en.students;
---

<Layout lang="en" route="students" title={content.title} description={content.description}>
	<section class="page-intro">
		<h1>{content.title}</h1>
		<p class="page-intro__lead">{content.intro}</p>
		<p class="page-intro__body">{content.supervisionIntro}</p>
	</section>

	<Section title="Postdoctoral researchers">
		<ul class="supervision-list">
			{supervisees.en.postdocs.map((person) => <li><PersonRecord person={person} /></li>)}
		</ul>
	</Section>

	<Section title="PhD students">
		<ul class="supervision-list">
			{supervisees.en.phds.map((person) => <li><PersonRecord person={person} /></li>)}
		</ul>
	</Section>

	<Section title="Master's students">
		<ul class="supervision-list">
			{supervisees.en.masters.map((item) => <li>{item}</li>)}
		</ul>
	</Section>
</Layout>
