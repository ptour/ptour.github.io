---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import PersonRecord from '../../components/PersonRecord.astro';
import { siteContent, supervisees, withBase } from '../../data/site';

const content = siteContent.fr.students;
---

<Layout lang="fr" route="students" title={content.title} description={content.description}>
	<section class="page-intro">
		<h1>{content.title}</h1>
		<p class="page-intro__lead">{content.intro}</p>
		<p class="page-intro__body">{content.researchDetail}</p>
		<p class="page-intro__body">{content.supervisionIntro}</p>
	</section>

	<figure class="page-figure">
		<img
			src={withBase('/blackboard.jpg')}
			alt={content.photo.alt}
			width="1800"
			height="1200"
			loading="lazy"
		/>
		<figcaption>{content.photo.caption}</figcaption>
	</figure>

	<Section title="Chercheuses et chercheurs postdoctoraux">
		<ul class="supervision-list">
			{supervisees.fr.postdocs.map((person) => <li><PersonRecord person={person} /></li>)}
		</ul>
	</Section>

	<Section title="Doctorantes et doctorants">
		<ul class="supervision-list">
			{supervisees.fr.phds.map((person) => <li><PersonRecord person={person} /></li>)}
		</ul>
	</Section>

	<Section title="Étudiantes et étudiants de master">
		<ul class="supervision-list">
			{supervisees.fr.masters.map((item) => <li>{item}</li>)}
		</ul>
	</Section>
</Layout>
