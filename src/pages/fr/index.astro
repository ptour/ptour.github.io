---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import { careerTimeline, funding, siteContent, siteIdentity } from '../../data/site';

const content = siteContent.fr.cv;
---

<Layout lang="fr" route="home" title={siteIdentity.name} description={content.description}>
	<section class="page-intro">
		<h1>{siteIdentity.name}</h1>
		<p class="page-intro__subtitle">{siteIdentity.title.fr} · {siteIdentity.affiliation}</p>
		<p class="page-intro__lead">{content.shortBio}</p>
	</section>

	<Section title="Thèmes de recherche">
		<ul class="keyword-list">
			{content.researchAreas.map((item) => <li>{item}</li>)}
		</ul>
	</Section>

	<Section title="Parcours académique">
		<div class="timeline">
			<ul>
				{careerTimeline.fr.map((item) => (
					<li><div class="timeline__period">{item.period}</div><div>{item.text}</div></li>
				))}
			</ul>
		</div>
	</Section>

	<Section title="Financements" lede={content.fundingIntro}>
		<div class="timeline">
			<ul>
				{funding.fr.map((grant) => (
					<li>
						<div class="timeline__period">{grant.period}</div>
						<div>
							{grant.href
								? <a href={grant.href}>{grant.name}</a>
								: <span>{grant.name}</span>}
							{`, ${grant.amount} — ${grant.note}`}
						</div>
					</li>
				))}
			</ul>
		</div>
	</Section>

	<Section title="Notre série de séminaires en ligne">
		<p>
			<a href={siteIdentity.links.seminar}>Neural Collisions</a> : des exposés ouverts à la discussion,
			à l’interface entre physique des hautes énergies et apprentissage automatique, destinés
			aux chercheuses et chercheurs de la région Annecy–Genève–Lausanne.
		</p>
	</Section>

	<Section title="CV complet et profils de publications">
		<ul class="link-list">
			<li><a href={siteIdentity.links.cv}>CV complet (PDF)</a></li>
			<li>
				La liste complète des articles se trouve sur :{' '}
				<a href={siteIdentity.links.inspire}>INSPIRE</a>{', '}
				<a href={siteIdentity.links.scholar}>Google Scholar</a>{', '}
				<a href={siteIdentity.links.arxiv}>arXiv</a>
			</li>
			<li>
				{'Lien vers mon compte '}
				<a href={siteIdentity.links.orcid}>ORCID</a>
			</li>
			<li>
				{'Le texte de mon '}
				<a href={siteIdentity.links.hdr}>habilitation à diriger des recherches</a>
				{' (PDF), soutenue le '}
				<time datetime="2026-03-26">26 mars 2026</time>
			</li>
		</ul>
	</Section>
</Layout>
