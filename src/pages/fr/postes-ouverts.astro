---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import { siteContent, siteIdentity, withBase } from '../../data/site';

const content = siteContent.fr.openPositions;
---

<Layout
	lang="fr"
	route="openPositions"
	title={content.title}
	description={content.description}
>
	<section class="page-intro">
		<p class="eyebrow">Opportunités</p>
		<h1>{content.title}</h1>
		<p class="page-intro__lead">
			{content.prospectiveNote.before}
			<a href={siteIdentity.links.lapthJobs} target="_blank" rel="noreferrer">{content.prospectiveNote.link}</a>
			{content.prospectiveNote.after}
		</p>
	</section>

	<Section title={content.internships.title} lede={content.internships.lede}>
		<ul class="link-list">
			{content.internships.items.map((item) => (
				<li>
					<a href={item.pdf}>{item.title}</a>
					{' (PDF; '}<a href={item.otherPdf}>{content.internships.otherLangLabel}</a>{')'}
				</li>
			))}
		</ul>
	</Section>

	<figure class="page-figure">
		<img
			src={withBase('/lake-annecy.jpg')}
			alt={content.photo.alt}
			width="1800"
			height="919"
			loading="lazy"
		/>
		<figcaption>{content.photo.caption}</figcaption>
	</figure>
</Layout>
