---
import { pathFor } from '../data/site';

const en = pathFor('en', 'home');
const fr = pathFor('fr', 'home');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta http-equiv="refresh" content={`0;url=${en}`} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Piotr Tourkine</title>
	</head>
	<body>
		<p><a href={en}>Continue to the English homepage</a></p>
		<p><a href={fr}>Continuer vers la page d’accueil en français</a></p>
	</body>
</html>
